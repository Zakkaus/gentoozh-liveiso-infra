# gig-os 自动构建的环境配置模板。
# 复制成 /opt/live-iso-builder/config.env，填真实值，chmod 600。
# config.env 在 .gitignore 里，不入库；脚本运行时 source。

# ── Cloudflare R2，发布目标 ──
# Cloudflare → R2 → Manage API Tokens 建 Object Read & Write、限定该 bucket 的 token。
# 构建机要装 rclone。字段缺了编译前预检会停。
R2_ACCESS_KEY_ID=                  # Access Key ID
R2_SECRET_ACCESS_KEY=              # Secret Access Key
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   # 账户级 S3 端点，不含 bucket
R2_BUCKET=gentoozh                 # bucket 名
R2_KEEP=3                          # R2 留最近几个 ISO
R2_PUBLIC_BASE=https://r2.gentoozh.org   # bucket 绑定的公开域，末尾不带斜杠

# ── 落地页，Cloudflare Worker 即时读 R2 ──
# 上传后核对它有没有反映新镜像；留空用默认。
MIRROR_URL=https://mirror.gentoozh.org/

# ── Telegram 通知，留空则不通知 ──
# @BotFather 建 bot，设为目标频道管理员。
TG_TOKEN=                          # bot token，如 123456:ABC...
TG_CHAT=                           # 频道，如 @your_channel
