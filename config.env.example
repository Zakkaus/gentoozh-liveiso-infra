# gig-os 自动构建的环境配置模板。
# 复制为 /opt/live-iso-builder/config.env，填入真实值并 chmod 600。config.env 不入库。

# 镜像站 distfiles.gentoozh.org，唯一发布目标。
# 构建机以 root 执行，root 的 ~/.ssh 需有可写镜像机 /srv/pub/gigos 的私钥。
# 留空则整段跳过，本次不对外发布。
MIRROR_SSH_TARGET=                 # 如 zakk@159.195.212.91
MIRROR_SSH_OPTS=                   # 如 -i /root/.ssh/gigos_mirror -p 60001
MIRROR_PATH=/srv/pub/gigos         # 镜像机上的落地目录
MIRROR_KEEP=2                      # 镜像站保留最近几个 ISO
MIRROR_PUBLIC_BASE=https://distfiles.gentoozh.org/gigos   # 公开域，末尾不带斜杠

# 落地页：Cloudflare Worker 读镜像站的目录清单，上传后核对是否已反映新镜像；留空用默认值。
MIRROR_URL=https://iso.gentoozh.org/

# Telegram 通知，留空则不通知。
# @BotFather 建 bot，设为目标频道管理员。
TG_TOKEN=                          # bot token，如 123456:ABC...
TG_CHAT=                           # 频道，如 @your_channel
