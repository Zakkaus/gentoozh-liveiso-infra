[Unit]
Description=Live ISO 构建失败时发 Telegram(补 wrapper 够不着的早期/语法体检失败盲区)
# 由 live-iso-build.service 的 OnFailure= 触发。本身不设 OnFailure,避免自递归。

[Service]
Type=oneshot
# 复用同一 config.env 取密钥，密钥不入库；curl 以 || true 收尾，避免通知本身再让 unit 失败。
# selfnotified 哨兵存在说明 wrapper 已发过 FAILED,此处直接退出；wrapper 无法自报时
#(SIGKILL、OOM、语法检查失败、config 缺失、非 root)哨兵不存在，由本 unit 兜底。
# 必须写 $$TG_TOKEN:systemd 会把未在 Environment 定义的 $VAR 替换为空，写成 $$ 才由 bash 在
# source config.env 后展开，否则 token 为空、curl 永不发出，等于静默。
# 文案不预设阶段，因为构建超时被终止时本 unit 同样触发，只指向 journalctl 排查。
ExecStart=/bin/bash -c '[ -e /run/live-iso-build.selfnotified ] && exit 0; . /opt/live-iso-builder/config.env 2>/dev/null; [ -n "$$TG_TOKEN" ] && [ -n "$$TG_CHAT" ] && curl -fsS -m 20 "https://api.telegram.org/bot$$TG_TOKEN/sendMessage" -d "chat_id=$$TG_CHAT" --data-urlencode "text=[FAILED] gig-os 构建:service 进入 failed(语法体检、config 缺失、极早期退出，或构建中途被杀);查 journalctl -u live-iso-build" >/dev/null 2>&1 || true'
