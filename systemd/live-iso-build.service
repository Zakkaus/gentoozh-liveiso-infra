[Unit]
Description=Gentoo 中文社区 Live ISO 自动构建并部署到下载站
After=network-online.target
Wants=network-online.target
# 任意原因 failed 都拉起通知 service，覆盖 wrapper 的 on_exit 够不到的盲区：语法检查失败、
# wrapper 极早期退出，此时通知函数尚未就绪。
OnFailure=live-iso-notify-fail.service

[Service]
Type=oneshot
# 进入数小时的构建之前先做 bash -n 语法检查，任一语法错即 failed，避免在 stage 之前静默失败。
# 只检查构建机本地的三个脚本，镜像站上的脚本路径不在本机，列入会误判失败。
ExecStartPre=/bin/bash -n /opt/live-iso-builder/build-and-deploy.sh
ExecStartPre=/bin/bash -n /opt/live-iso-builder/verify-iso.sh
ExecStartPre=/bin/bash -n /opt/live-iso-builder/reupload-iso.sh
ExecStart=/opt/live-iso-builder/build-and-deploy.sh
# 超时须同时覆盖 CPU 预检最坏延后（12×30 分钟）与全量构建（约 3-4 小时），故设 12 小时。
TimeoutStartSec=43200
# 提高本服务的 OOM 分值，内存不足时优先中止构建而非系统其他进程
OOMScoreAdjust=200
Nice=5
